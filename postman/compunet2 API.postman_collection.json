		{
			"name": "Users - Create",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"pm.test('create user 200', function () { pm.response.to.have.status(200); });",
							"var json = pm.response.json();",
							"pm.environment.set('createdUserId', json.id);",
							"pm.environment.set('createdUsername', json.username);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				},
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"const rnd = Math.floor(Math.random()*10000);\r",
							"const username = 'postman_user_' + rnd;\r",
							"pm.environment.set('randomUsername', username);\r",
							"pm.environment.set('createdEmail', `postman+${rnd}@example.com`);"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
					},
					{
						"key": "Authorization",
						"value": "Bearer {{token}}"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"username\": \"{{randomUsername}}\",\n  \"email\": \"{{createdEmail}}\",\n  \"password\": \"Pwd12345!\",\n  \"roleId\": 1\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/users",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"users"
					]
				}
			},
			"response": []
		},
